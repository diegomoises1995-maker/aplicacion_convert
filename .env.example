# ── Base de datos (PostgreSQL) ──────────────────────────────────────────
# Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/convert_ventas"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/convert_ventas"
# Supabase (Project Settings → Database → Connection string):
# DATABASE_URL = conexión "Transaction pooler" (puerto 6543) + "?pgbouncer=true&connection_limit=1"
# DIRECT_URL   = conexión "Session pooler"/directa (puerto 5432), usada por las migraciones

# ── Autenticación (Auth.js) ──────────────────────────────────────────────
# Generar con:  npx auth secret   o   openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
AUTH_TRUST_HOST=true

# ── Seed (opcional) ─────────────────────────────────────────────────────
# Contraseña de los usuarios de prueba (por defecto: Convert2026)
# SEED_PASSWORD="Convert2026"
